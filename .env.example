# MongoDB
MONGODB_URI='mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app>'
CONNECTION_STRING='mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app>'
DB_NAME='familoveDB'
COLLECTION_NAME='familoveCollection'
USER_COLLECTION_NAME='userCollection'
MEAL_COLLECTION_NAME='mealCollection'
NOTIFICATION_COLLECTION_NAME='notificationLog'
RABBITMQ_URL='amqp://localhost:5672'

# Runtime
PORT=3000
NODE_ENV='development'
# Comma-separated list of allowed browser origins
CLIENT_ORIGINS='http://localhost:5173,http://localhost:3000'

# JWT (generate strong random secrets, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET='<random-access-secret>'
JWT_ACCESS_EXPIRES_IN='15m'
JWT_ISSUER='familove'
JWT_AUDIENCE='familove-client'
REFRESH_TOKEN_EXPIRES_IN='7d'

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Refresh-token cookies (browser clients)
REFRESH_COOKIE_NAME='refreshToken'
CSRF_COOKIE_NAME='csrfToken'
COOKIE_SECURE=false
COOKIE_SAME_SITE='lax'
COOKIE_DOMAIN=''
